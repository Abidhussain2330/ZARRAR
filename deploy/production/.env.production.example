# Copy to .env.production, set mode 0600, and replace every REQUIRED value.
# Operator scripts source this file, so quote any non-base64 value containing shell metacharacters.
COMPOSE_PROJECT_NAME=buraq
BURAQ_IMAGE=buraq:1.8.7
# Source-built from the pinned final upstream commits; publish immutable reviewed tags.
BURAQ_MINIO_IMAGE=buraq-minio:7aac2a2
BURAQ_MC_IMAGE=buraq-minio-client:77f82e1
BURAQ_VOLUME_PREFIX=buraq

# Public edge
BURAQ_DOMAIN=ctf.example.com
BURAQ_PUBLIC_URL=https://ctf.example.com
BURAQ_ALLOWED_HOSTS=ctf.example.com
ACME_EMAIL=ops@example.com
BURAQ_HTTP_PORT=80
BURAQ_HTTPS_PORT=443
BURAQ_PROXY_IP=172.30.0.10
BURAQ_APP_EDGE_IP=172.30.0.20
BURAQ_EDGE_SUBNET=172.30.0.0/24
BURAQ_PROXY_BODY_LIMIT=512MB

# Independent high-entropy secrets (generate each independently with: openssl rand -base64 48)
BURAQ_XOR_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
BURAQ_DYNAMIC_FLAG_HMAC_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
BURAQ_SHARED_GATEWAY_SIGNING_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
BURAQ_VARIANT_SEED_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
BURAQ_BOOTSTRAP_ADMIN_PASSWORD=

# Runtime provider: Docker or MicroVm
BURAQ_RUNTIME_PROVIDER=Docker
BURAQ_RUNTIME_MAX_INSTANCES=0

# Docker provider. Set the actual socket GID (`stat -c %g /var/run/docker.sock`).
DOCKER_GID=REQUIRED_NUMERIC_DOCKER_SOCKET_GID
BURAQ_RUNTIME_SOCKET_SOURCE=/var/run/docker.sock
BURAQ_CHALLENGE_NETWORK_PREFIX=buraq
BURAQ_CHALLENGE_PIDS_LIMIT=512

# MicroVM provider. When enabled, set socket source to /dev/null so BURAQ has no Docker authority.
BURAQ_MICROVM_ORIGIN=https://microvm-control.internal.example/
BURAQ_MICROVM_TOKEN=REQUIRED_SCOPED_MICROVM_CONTROL_PLANE_TOKEN
BURAQ_MICROVM_NODE=microvm-primary
BURAQ_MICROVM_HEALTH_PATH=v1/health
BURAQ_MICROVM_TIMEOUT_SECONDS=30

# Shared Web/API and deterministic variant services
BURAQ_SHARED_GATEWAY_ALLOWED_ORIGIN=
BURAQ_VARIANT_BUILDER_ENABLED=false
BURAQ_VARIANT_BUILDER_ORIGIN=https://variant-builder.internal.example/
BURAQ_VARIANT_BUILDER_TOKEN=REQUIRED_SCOPED_VARIANT_BUILDER_TOKEN
BURAQ_VARIANT_BUILDER_PARALLELISM=2
BURAQ_VARIANT_MAX_ARTIFACT_BYTES=67108864

# Data services
POSTGRES_DB=buraq
POSTGRES_USER=buraq
POSTGRES_PASSWORD=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
REDIS_PASSWORD=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
MINIO_ROOT_USER=buraq-storage
MINIO_ROOT_PASSWORD=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
MINIO_ACCESS_KEY=buraq-app
MINIO_SECRET_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
MINIO_BUCKET=buraq

# Optional SMTP
BURAQ_REQUIRE_SMTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=BURAQ
SMTP_TLS_BYPASS=false

# Operational limits
BURAQ_MAX_REQUEST_BODY_BYTES=536870912
BURAQ_REQUEST_LOGGING=false
BURAQ_ENABLE_TRAFFIC_CAPTURE=false
BURAQ_APP_CPUS=2.0
BURAQ_APP_MEMORY=2g
CADDY_CPUS=0.50
CADDY_MEMORY=256m
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2g
REDIS_CPUS=0.50
REDIS_MEMORY=512m
MINIO_CPUS=1.0
MINIO_MEMORY=1g
