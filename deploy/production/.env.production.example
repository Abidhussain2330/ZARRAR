# Copy to .env.production, set mode 0600, and replace every REQUIRED value.
# Operator scripts source this file, so quote any non-base64 value containing shell metacharacters.
COMPOSE_PROJECT_NAME=zarrar
ZARRAR_IMAGE=zarrar:1.8.7
# Source-built from the pinned final upstream commits; publish immutable reviewed tags.
ZARRAR_MINIO_IMAGE=zarrar-minio:7aac2a2
ZARRAR_MC_IMAGE=zarrar-minio-client:77f82e1
ZARRAR_VOLUME_PREFIX=zarrar

# Public edge
ZARRAR_DOMAIN=ctf.example.com
ZARRAR_PUBLIC_URL=https://ctf.example.com
ZARRAR_ALLOWED_HOSTS=ctf.example.com
ACME_EMAIL=ops@example.com
ZARRAR_HTTP_PORT=80
ZARRAR_HTTPS_PORT=443
ZARRAR_PROXY_IP=172.30.0.10
ZARRAR_APP_EDGE_IP=172.30.0.20
ZARRAR_EDGE_SUBNET=172.30.0.0/24
ZARRAR_PROXY_BODY_LIMIT=512MB

# Independent high-entropy secrets (generate each independently with: openssl rand -base64 48)
ZARRAR_XOR_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
ZARRAR_DYNAMIC_FLAG_HMAC_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
ZARRAR_SHARED_GATEWAY_SIGNING_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
ZARRAR_VARIANT_SEED_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
ZARRAR_BOOTSTRAP_ADMIN_PASSWORD=

# Runtime provider: Docker or MicroVm
ZARRAR_RUNTIME_PROVIDER=Docker
ZARRAR_RUNTIME_MAX_INSTANCES=0

# Docker provider. Set the actual socket GID (`stat -c %g /var/run/docker.sock`).
DOCKER_GID=REQUIRED_NUMERIC_DOCKER_SOCKET_GID
ZARRAR_RUNTIME_SOCKET_SOURCE=/var/run/docker.sock
ZARRAR_CHALLENGE_NETWORK_PREFIX=zarrar
ZARRAR_CHALLENGE_PIDS_LIMIT=512

# MicroVM provider. When enabled, set socket source to /dev/null so ZARRAR has no Docker authority.
ZARRAR_MICROVM_ORIGIN=https://microvm-control.internal.example/
ZARRAR_MICROVM_TOKEN=REQUIRED_SCOPED_MICROVM_CONTROL_PLANE_TOKEN
ZARRAR_MICROVM_NODE=microvm-primary
ZARRAR_MICROVM_HEALTH_PATH=v1/health
ZARRAR_MICROVM_TIMEOUT_SECONDS=30

# Shared Web/API and deterministic variant services
ZARRAR_SHARED_GATEWAY_ALLOWED_ORIGIN=
ZARRAR_VARIANT_BUILDER_ENABLED=false
ZARRAR_VARIANT_BUILDER_ORIGIN=https://variant-builder.internal.example/
ZARRAR_VARIANT_BUILDER_TOKEN=REQUIRED_SCOPED_VARIANT_BUILDER_TOKEN
ZARRAR_VARIANT_BUILDER_PARALLELISM=2
ZARRAR_VARIANT_MAX_ARTIFACT_BYTES=67108864

# Data services
POSTGRES_DB=zarrar
POSTGRES_USER=zarrar
POSTGRES_PASSWORD=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
REDIS_PASSWORD=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
MINIO_ROOT_USER=zarrar-storage
MINIO_ROOT_PASSWORD=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
MINIO_ACCESS_KEY=zarrar-app
MINIO_SECRET_KEY=REQUIRED_INDEPENDENT_64_CHARACTER_SECRET
MINIO_BUCKET=zarrar

# Optional SMTP
ZARRAR_REQUIRE_SMTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=ZARRAR
SMTP_TLS_BYPASS=false

# Operational limits
ZARRAR_MAX_REQUEST_BODY_BYTES=536870912
ZARRAR_REQUEST_LOGGING=false
ZARRAR_ENABLE_TRAFFIC_CAPTURE=false
ZARRAR_APP_CPUS=2.0
ZARRAR_APP_MEMORY=2g
CADDY_CPUS=0.50
CADDY_MEMORY=256m
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2g
REDIS_CPUS=0.50
REDIS_MEMORY=512m
MINIO_CPUS=1.0
MINIO_MEMORY=1g
