{
	admin off
	email {$ACME_EMAIL}
}

{$ZARRAR_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size {$ZARRAR_PROXY_BODY_LIMIT}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy zarrar:8080

	log {
		output stdout
		format json
	}
}
