      <!-- Pinned to the patched build: 10.0.9 carries five high-severity advisories
         (GHSA-23rf-6693-g89p, -8q5v-6pqq-x66h, -cvvh-rhrc-wg4q, -g8r8-53c2-pm3f,
         -mmjf-rqrv-855v) and 10.0.10-10.0.12 three more (GHSA-7hqp-7c5m-4vq6, -c399-9853-6jmj,
         -r955-8q5j-3h83). Reached only transitively by the test host, never by the
         shipped application, but pinned so a clean restore is advisory-free. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Transitive pins for advisories reported by restore (20 Oct 2026):
         Pkcs 10.0.0-10.0.12: GHSA-846f-f764-76mx (high), GHSA-2fmv-rv2c-59x7 (moderate), both DoS.
         MessagePack <= 2.5.302: GHSA-qhrr-8q5h-9q3h (moderate, nested-array memory amplification).
         Stay on MessagePack 2.x: the SignalR MessagePack protocol is compiled against it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="MessagePack" Version="2.5.303" />
